# FRIDAY Master Environment Configuration Specification

# Application
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:6000

# Database
DB_PATH=./friday.db
DATABASE_URL=postgresql://user:password@localhost:5432/friday
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://localhost:27017/friday_logs

# Authentication
JWT_SECRET=stark-industries-jwt-secret-min-32-chars
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=2592000
SERVER_ENCRYPTION_KEY=STARK_SERVER_E2E_KEY_2026

# Google Workspace OAuth
GOOGLE_CLIENT_ID=mock_stark_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_stark_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Multi-Channel Integrations
VIBER_BOT_TOKEN=MOCK_VIBER_TOKEN_FRIDAY
MESSENGER_PAGE_TOKEN=MOCK_FB_PAGE_TOKEN
MESSENGER_VERIFY_TOKEN=MOCK_VERIFY_TOKEN

# Speech & Voice AI
OPENAI_API_KEY=mock_openai_api_key
ELEVENLABS_API_KEY=mock_elevenlabs_api_key
AZURE_SPEECH_KEY=mock_azure_speech_key
AZURE_SPEECH_REGION=eastus
